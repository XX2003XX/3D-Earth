<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Strength</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #0f172a;
            font-family: Arial, sans-serif;
        }

        .box {
            width: 340px;
            padding: 30px;
            background: #111827;
            border-radius: 20px;
            color: white;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
        }

        h2 {
            margin-top: 0;
            margin-bottom: 25px;
            text-align: center;
            font-size: 26px;
        }

        .input-box {
            position: relative;
        }

        input {
            width: 100%;
            padding: 14px 45px 14px 14px;
            border: 1px solid #334155;
            border-radius: 10px;
            background: #1e293b;
            color: white;
            outline: none;
            font-size: 15px;
            transition: 0.2s;
        }

        input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        input::placeholder {
            color: #64748b;
        }

        .eye {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            opacity: 0.7;
        }

        .strength {
            height: 4px;
            margin-top: 18px;
            background: #334155;
            border-radius: 20px;
            overflow: hidden;
        }

        .bar {
            width: 0;
            height: 100%;
            border-radius: 20px;
            background: #6366f1;
            transition: 0.3s;
        }

        .message {
            margin-top: 10px;
            font-size: 14px;
            color: #94a3b8;
        }
    </style>
</head>

<body>

    <div class="box">

        <h2>Create Password</h2>

        <div class="input-box">
            <input
                type="password"
                id="password"
                placeholder="Enter password"
            >

            <span class="eye" id="eye">👁️</span>
        </div>

        <div class="strength">
            <div class="bar"></div>
        </div>

        <div class="message" id="message">
            Start typing...
        </div>

    </div>

    <script>
        const password = document.getElementById("password");
        const message = document.getElementById("message");
        const bar = document.querySelector(".bar");
        const eye = document.getElementById("eye");

        function setStrength(text, width, color) {
            message.textContent = text;
            message.style.color = color;
            bar.style.width = width;
            bar.style.background = color;
        }

        password.addEventListener("input", function () {
            const value = password.value;

            if (value.length === 0) {
                message.textContent = "Start typing...";
                message.style.color = "#94a3b8";
                bar.style.width = "0%";
                bar.style.background = "#6366f1";
                return;
            }

            const lower = value.toLowerCase();
            let score = 0;

            if (value.length >= 8) score += 2;
            if (value.length >= 12) score += 2;
            if (value.length >= 16) score += 2;

            if (/[a-z]/.test(value)) score++;
            if (/[A-Z]/.test(value)) score++;
            if (/[0-9]/.test(value)) score++;
            if (/[^A-Za-z0-9]/.test(value)) score++;

            if (new Set(lower).size >= 8) score++;

            if (
                lower === "password" ||
                lower === "123456" ||
                lower === "12345678" ||
                lower === "qwerty" ||
                lower === "admin"
            ) {
                score = 0;
            }

            if (/123|234|345|456|567|678|789/.test(lower)) {
                score -= 1;
            }

            if (/(.)\1{2,}/.test(value)) {
                score -= 2;
            }

            if (score <= 3) {
                setStrength("Easy", "33%", "#22c55e");
            } else if (score <= 7) {
                setStrength("Medium", "66%", "#eab308");
            } else {
                setStrength("Hard", "100%", "#ef4444");
            }
        });

        eye.addEventListener("click", function () {
            if (password.type === "password") {
                password.type = "text";
                eye.textContent = "🙈";
            } else {
                password.type = "password";
                eye.textContent = "👁️";
            }
        });
    </script>

</body>
</html>
